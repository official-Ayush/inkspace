# Supabase dashboard > Connect. Use the publishable key, NEVER a secret/service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Comma-separated emails that may sign in. Empty means access is disabled.
# Also create these users in Supabase Auth and disable new user signups.
INKSPACE_ALLOWED_EMAILS=you@example.com

# Required in production. Configure the matching secret in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
